# Copy this file to .env and fill in local values. .env is gitignored.
# Never commit real secrets.

COMPOSE_PROJECT_NAME=ritm
WEB_PORT=8080

APP_NAME=Ritm
APP_ENV=local
APP_DEBUG=true
# Generate with: openssl rand -base64 32
# Then prefix the result with "base64:".
APP_KEY=
APP_URL=http://localhost:8080
# Apiato uses API_URL as the API route domain. Do not add a port here:
# Laravel matches route domains against the host without the port.
API_URL=http://localhost
FRONTEND_URL=http://localhost:8080
APP_TIMEZONE=UTC

MYSQL_DATABASE=ritm
MYSQL_USER=ritm
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_VOLUME_NAME=ritm_mysql_data
BACKEND_STORAGE_VOLUME_NAME=ritm_backend_storage

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080

# Local compose builds dev dependencies so `php artisan test` works.
# Set to false for a production image.
INSTALL_DEV_DEPS=true

# Optional: leave empty for same-origin requests through nginx.
VITE_API_BASE_URL=
