# Copy to /opt/ritm/.env.production on the server (never commit it; chmod 600).
# This template contains placeholders only, not real credentials.
#
# The file is read by Docker Compose for interpolation. It is NOT passed as
# env_file to the backend, so MYSQL_ROOT_PASSWORD stays in the MySQL container.

COMPOSE_PROJECT_NAME=ritm-prod

# Public domain for Caddy, Laravel URLs and Sanctum stateful domains.
DOMAIN=example.com

APP_NAME=Ritm

# Prebuilt linux/amd64 images, loaded on the server. The stack never builds.
BACKEND_IMAGE=ritm-backend:b950e2e-amd64
WEB_IMAGE=ritm-web:b950e2e-amd64
MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=ritm
MYSQL_USER=ritm
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# openssl rand -base64 32, then prefix the result with "base64:".
APP_KEY=base64:CHANGE_ME_OPENSSL_RAND_BASE64_32

# Long random string, e.g. openssl rand -hex 32. Never reuse APP_KEY.
HASH_ID_KEY=CHANGE_ME_LONG_RANDOM_HASH_ID_KEY
